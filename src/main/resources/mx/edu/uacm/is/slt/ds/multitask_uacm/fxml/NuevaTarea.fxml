<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<Pane prefHeight="600.0" prefWidth="850.0"
      style="-fx-background-color: #F2EDE6;"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="mx.edu.uacm.is.slt.ds.multitask_uacm.controlador.VisorDeTareasController">

   <children>
      
      <!-- HEADER -->
      <Pane prefHeight="80.0" prefWidth="850.0"
            style="-fx-background-color: #D9CCC5; -fx-border-width: 0 0 2 0; -fx-border-color: #C3A495;">
         <effect>
            <DropShadow color="#0000001a" height="10.0" radius="4.5" width="10.0" />
         </effect>
         <children>
            <ImageView fx:id="logoImageView" fitHeight="60.0" fitWidth="130.0"
                       layoutX="15.0" layoutY="10.0"
                       pickOnBounds="true" preserveRatio="true" />
            
            <Label layoutX="330.0" layoutY="22.0" text="Visor de Tareas" textFill="#2C1810">
               <font>
                  <Font name="Arial Black" size="26.0" />
               </font>
            </Label>
         </children>
      </Pane>

      <!-- DATOS DE OPERACION -->
      <Pane layoutX="25.0" layoutY="100.0" prefHeight="60.0" prefWidth="800.0"
            style="-fx-background-color: #FFFFFF; -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #D9CCC5; -fx-border-width: 1;">
         <children>
            <Label layoutX="15.0" layoutY="22.0" text="Operacion:" style="-fx-font-family: 'Arial Black'; -fx-font-size: 13px;"/>
            <TextField fx:id="txt_nombreOperacion" layoutX="110.0" layoutY="18.0" prefWidth="250.0" editable="false" 
                       style="-fx-background-color: #F5F5F5; -fx-border-radius: 5; -fx-padding: 8;"/>
            
            <Label layoutX="400.0" layoutY="22.0" text="Estado:" style="-fx-font-family: 'Arial Black'; -fx-font-size: 13px;"/>
            <TextField fx:id="txt_estado" layoutX="480.0" layoutY="18.0" prefWidth="150.0" editable="false" 
                       style="-fx-background-color: #F5F5F5; -fx-border-radius: 5; -fx-padding: 8;"/>
         </children>
      </Pane>

      <!-- TABLA DE TAREAS -->
      <Label layoutX="30.0" layoutY="180.0" text="Lista de Tareas:" style="-fx-font-family: 'Arial Black'; -fx-font-size: 14px;"/>
      
      <TableView fx:id="tablaTareasVisor" layoutX="25.0" layoutY="205.0" prefHeight="280.0" prefWidth="800.0"
                 style="-fx-background-color: #FFFFFF; -fx-background-radius: 10; -fx-border-radius: 10;">
         <columns>
            <TableColumn fx:id="tlc_nombre" text="Tarea" prefWidth="200.0"/>
            <TableColumn fx:id="tlb_tipo" text="Tipo" prefWidth="120.0"/>
            <TableColumn fx:id="tlb_descripcion" text="Descripcion" prefWidth="300.0"/>
            <TableColumn fx:id="tlb_accionTarea" text="Acciones" prefWidth="150.0"/>
         </columns>
      </TableView>

      <!-- BOTONES -->
      <Button layoutX="25.0" layoutY="505.0"
              prefHeight="40.0" prefWidth="160.0"
              text="+ Nueva Tarea"
              onAction="#abrirNuevaTarea"
              style="-fx-background-color: #C3A495; -fx-font-family: 'Arial Black'; -fx-font-size: 13px; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand;">
         <effect>
            <DropShadow color="#00000030" offsetY="2.0" radius="3.0" />
         </effect>
      </Button>

      <Button layoutX="680.0" layoutY="505.0"
              prefHeight="40.0" prefWidth="145.0"
              text="Cerrar"
              onAction="#cerrarVisor"
              style="-fx-background-color: #C3A495; -fx-font-family: 'Arial Black'; -fx-font-size: 13px; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand;">
         <effect>
            <DropShadow color="#00000030" offsetY="2.0" radius="3.0" />
         </effect>
      </Button>

      <!-- FOOTER -->
      <Pane layoutY="560.0" prefHeight="40.0" prefWidth="850.0"
            style="-fx-background-color: #D9CCC5; -fx-border-width: 2 0 0 0; -fx-border-color: #C3A495;"/>

   </children>
</Pane>