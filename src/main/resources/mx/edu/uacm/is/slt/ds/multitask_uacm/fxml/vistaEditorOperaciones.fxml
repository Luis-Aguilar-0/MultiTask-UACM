<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<Pane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" 
      prefHeight="550.0" prefWidth="800.0" 
      style="-fx-background-color: #F2EDE6;" 
      stylesheets="@../css/estilos.css"
      xmlns="http://javafx.com/javafx/21" 
      xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="mx.edu.uacm.is.slt.ds.multitask_uacm.controlador.VisorEditorOperacionController">
      
   <children>
   
      <!-- HEADER -->
      <Pane prefHeight="80.0" prefWidth="800.0" 
            style="-fx-background-color: #D9CCC5; -fx-border-width: 0 0 2 0; -fx-border-color: #C3A495;">
         <effect>
            <DropShadow color="#0000001a" height="10.0" radius="4.5" width="10.0" />
         </effect>
         <children>
            <ImageView fx:id="logoImageView" fitHeight="60.0" fitWidth="130.0"
                       layoutX="15.0" layoutY="10.0"
                       pickOnBounds="true" preserveRatio="true" />
            
            <Label layoutX="300.0" layoutY="22.0" text="Editor de Operaciones" textFill="#2C1810">
               <font>
                  <Font name="Arial Black" size="26.0" />
               </font>
            </Label>
         </children>
      </Pane>

      <!-- PANEL PRINCIPAL -->
      <Pane layoutX="25.0" layoutY="100.0" prefHeight="380.0" prefWidth="750.0" 
            style="-fx-background-color: #FFFFFF; -fx-background-radius: 12; -fx-border-radius: 12; -fx-border-color: #D9CCC5; -fx-border-width: 2;">
         <effect>
            <DropShadow color="#00000015" offsetX="2.0" offsetY="4.0" radius="10.0" />
         </effect>
         
         <children>
            
            <!-- SECCION IZQUIERDA -->
            <!-- Nombre -->
            <Label layoutX="25.0" layoutY="20.0" text="Nombre de la operacion" styleClass="label-normal">
               <font>
                  <Font name="Arial Black" size="13.0" />
               </font>
            </Label>
            <TextField fx:id="txtNombreOperacionEdicion" layoutX="25.0" layoutY="45.0" 
                       prefHeight="35.0" prefWidth="320.0" 
                       styleClass="text-field"/>

            <!-- Estado -->
            <Label layoutX="25.0" layoutY="95.0" text="Estado" styleClass="label-normal">
               <font>
                  <Font name="Arial Black" size="13.0" />
               </font>
            </Label>
            <ComboBox fx:id="comboEstadoOperacion" layoutX="25.0" layoutY="120.0" 
                      prefHeight="35.0" prefWidth="320.0" 
                      styleClass="combo-box" />

            <!-- Descripcion -->
            <Label layoutX="25.0" layoutY="170.0" text="Descripcion" styleClass="label-normal">
               <font>
                  <Font name="Arial Black" size="13.0" />
               </font>
            </Label>
            <TextArea fx:id="txtDescripcionOperacion" layoutX="25.0" layoutY="195.0" 
                      prefHeight="140.0" prefWidth="320.0" 
                      styleClass="text-area" wrapText="true"/>

            <!-- DIVISOR -->
            <Pane layoutX="370.0" layoutY="15.0" prefHeight="350.0" prefWidth="2.0" 
                  style="-fx-background-color: #E8DFD9;" />

            <!-- SECCION DERECHA - SOLO LISTA DE TAREAS -->
            <Label layoutX="395.0" layoutY="20.0" text="Lista de Tareas" styleClass="label-normal">
               <font>
                  <Font name="Arial Black" size="14.0" />
               </font>
            </Label>
            
            <ListView fx:id="listaTareasEdicion" layoutX="395.0" layoutY="50.0" 
                      prefHeight="300.0" prefWidth="330.0" 
                      styleClass="list-view" />

         </children>
      </Pane>

      <!-- BOTONES PRINCIPALES -->
      <Button fx:id="btnGuardar" layoutX="580.0" layoutY="498.0" 
              mnemonicParsing="false" onAction="#guardar" 
              prefHeight="35.0" prefWidth="100.0" 
              styleClass="button" text="Guardar">
         <effect>
            <DropShadow color="#00000030" offsetX="0.0" offsetY="2.0" radius="4.0" />
         </effect>
      </Button>
      
      <Button fx:id="btnCancelar" layoutX="695.0" layoutY="498.0" 
              mnemonicParsing="false" onAction="#cerrarVentana" 
              prefHeight="35.0" prefWidth="80.0" 
              styleClass="button" text="Cancelar">
         <effect>
            <DropShadow color="#00000030" offsetX="0.0" offsetY="2.0" radius="4.0" />
         </effect>
      </Button>
      
   </children>
</Pane>