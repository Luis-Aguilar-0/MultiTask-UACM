<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<Pane prefHeight="500.0" prefWidth="700.0"
      style="-fx-background-color: #F2EDE6;"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="mx.edu.uacm.is.slt.ds.multitask_uacm.controlador.VisorDeTareasController">

   <children>
      
      <!-- HEADER -->
      <Pane prefHeight="88.0" prefWidth="700.0"
            style="-fx-background-color: #D9CCC5;">
         <children>
            <ImageView fx:id="logoImageView" fitHeight="70.0" fitWidth="150.0"
                       layoutX="20.0" layoutY="10.0"
                       pickOnBounds="true" preserveRatio="true" />
            
            <Label layoutX="250.0" layoutY="25.0"
                   text="Visor de Tareas"
                   style="-fx-font-family: 'Arial Black'; -fx-font-size: 22px;"/>
         </children>
      </Pane>

      <!-- DATOS DE OPERACION -->
      <Label layoutX="30.0" layoutY="110.0" text="Operacion:" style="-fx-font-weight: bold;"/>
      <TextField fx:id="txt_nombreOperacion" layoutX="120.0" layoutY="105.0" prefWidth="200.0" editable="false"/>
      
      <Label layoutX="350.0" layoutY="110.0" text="Estado:" style="-fx-font-weight: bold;"/>
      <TextField fx:id="txt_estado" layoutX="420.0" layoutY="105.0" prefWidth="150.0" editable="false"/>

      <!-- TABLA DE TAREAS -->
      <Label layoutX="30.0" layoutY="160.0" text="Lista de Tareas:" style="-fx-font-weight: bold;"/>
      
      <TableView fx:id="tablaTareasVisor" layoutX="30.0" layoutY="185.0" prefHeight="250.0" prefWidth="640.0">
         <columns>
            <TableColumn fx:id="tlc_nombre" text="Nombre de Tarea" prefWidth="250.0"/>
            <TableColumn fx:id="tlb_descripcion" text="Descripcion" prefWidth="380.0"/>
         </columns>
      </TableView>

      <!-- BOTONES -->
      <Button layoutX="30.0" layoutY="450.0"
              prefHeight="35.0" prefWidth="150.0"
              text="+ Nueva Tarea"
              onAction="#abrirNuevaTarea"
              style="-fx-background-color: #C3A495; -fx-font-family: 'Arial Black'; -fx-font-size: 12px;">
         <effect><DropShadow/></effect>
      </Button>

      <Button layoutX="520.0" layoutY="450.0"
              prefHeight="35.0" prefWidth="150.0"
              text="Cerrar"
              onAction="#cerrarVisor"
              style="-fx-background-color: #C3A495; -fx-font-family: 'Arial Black'; -fx-font-size: 12px;">
         <effect><DropShadow/></effect>
      </Button>

      <!-- FOOTER -->
      <Pane layoutY="470.0" prefHeight="30.0" prefWidth="700.0"
            style="-fx-background-color: #D9CCC5;"/>

   </children>
</Pane>