<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<Pane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" 
      prefHeight="600.0" prefWidth="900.0" 
      style="-fx-background-color: #F2EDE6;" 
      stylesheets="@../css/estilos.css"
      xmlns="http://javafx.com/javafx/21" 
      xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="mx.edu.uacm.is.slt.ds.multitask_uacm.controlador.VisorDeTareasController">
      
   <children>
   
      <!-- HEADER -->
      <Pane prefHeight="90.0" prefWidth="900.0" 
            style="-fx-background-color: #D9CCC5; -fx-border-width: 0 0 2 0; -fx-border-color: #C3A495;">
         <effect>
            <DropShadow color="#0000001a" height="10.0" radius="4.5" width="10.0" />
         </effect>
         <children>
            <ImageView fx:id="logoImageView" fitHeight="70.0" fitWidth="150.0"
                       layoutX="20.0" layoutY="10.0"
                       pickOnBounds="true" preserveRatio="true" />
            
            <Label layoutX="360.0" layoutY="20.0" text="MultiTask - UACM" textFill="#2C1810">
               <font>
                  <Font name="Arial Black" size="30.0" />
               </font>
            </Label>
            
            <Label layoutX="400.0" layoutY="58.0" text="Visor de Tareas" textFill="#5C3D2E">
               <font>
                  <Font name="Arial" size="14.0" />
               </font>
            </Label>
         </children>
      </Pane>

      <!-- PANEL PRINCIPAL -->
      <Pane layoutX="30.0" layoutY="110.0" prefHeight="440.0" prefWidth="840.0" 
            style="-fx-background-color: #FFFFFF; -fx-background-radius: 15; -fx-border-radius: 15; -fx-border-color: #D9CCC5; -fx-border-width: 2;">
         <effect>
            <DropShadow color="#00000015" offsetX="2.0" offsetY="4.0" radius="12.0" />
         </effect>
         
         <children>
            
            <!-- TITULO DEL PANEL -->
            <Label layoutX="30.0" layoutY="20.0" text="Informacion de la Operacion" textFill="#5C3D2E">
               <font>
                  <Font name="Arial Black" size="16.0" />
               </font>
            </Label>
            
            <Separator layoutX="30.0" layoutY="55.0" prefWidth="780.0" />

            <!-- DATOS DE OPERACION -->
            <Label layoutX="40.0" layoutY="80.0" text="Nombre:" style="-fx-font-family: 'Arial Black'; -fx-font-size: 13px; -fx-text-fill: #5C3D2E;"/>
            <TextField fx:id="txt_nombreOperacion" layoutX="140.0" layoutY="75.0" prefHeight="32.0" prefWidth="300.0" 
                       editable="false" style="-fx-background-color: #F5F5F5; -fx-background-radius: 6; -fx-border-radius: 6; -fx-padding: 6;" />

            <Label layoutX="480.0" layoutY="80.0" text="Estado:" style="-fx-font-family: 'Arial Black'; -fx-font-size: 13px; -fx-text-fill: #5C3D2E;"/>
            <TextField fx:id="txt_estado" layoutX="560.0" layoutY="75.0" prefHeight="32.0" prefWidth="250.0" 
                       editable="false" style="-fx-background-color: #F5F5F5; -fx-background-radius: 6; -fx-border-radius: 6; -fx-padding: 6;" />

            <!-- SEPARADOR -->
            <Separator layoutX="30.0" layoutY="125.0" prefWidth="780.0" />

            <!-- TABLA DE TAREAS -->
            <Label layoutX="30.0" layoutY="145.0" text="Lista de Tareas" textFill="#5C3D2E">
               <font>
                  <Font name="Arial Black" size="14.0" />
               </font>
            </Label>
            
            <TableView fx:id="tablaTareasVisor" layoutX="30.0" layoutY="175.0" prefHeight="200.0" prefWidth="780.0"
                       style="-fx-background-color: #FFFFFF; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #D9CCC5; -fx-border-width: 1;">
               <columns>
                  <!-- Columna Tarea alineada a la izquierda -->
                  <TableColumn fx:id="tlc_nombre" text="Tarea" prefWidth="300.0">
                     <style>-fx-alignment: CENTER-LEFT;</style>
                  </TableColumn>
                  <!-- Columna Tipo centrada -->
                  <TableColumn fx:id="tlb_tipo" text="Tipo" prefWidth="180.0">
                     <style>-fx-alignment: CENTER;</style>
                  </TableColumn>
                  <!-- Columna Acciones centrada -->
                  <TableColumn fx:id="tlb_accionTarea" text="Acciones" prefWidth="300.0">
                     <style>-fx-alignment: CENTER;</style>
                  </TableColumn>
               </columns>
            </TableView>

            <!-- BOTONES INFERIORES -->
            <Button fx:id="btnNuevaTarea" layoutX="30.0" layoutY="395.0" 
                    mnemonicParsing="false" onAction="#abrirNuevaTarea" 
                    prefHeight="35.0" prefWidth="160.0" 
                    styleClass="button" text="+ Nueva Tarea">
               <effect>
                  <DropShadow color="#00000030" offsetX="0.0" offsetY="2.0" radius="4.0" />
               </effect>
            </Button>
            
            <Button fx:id="btnCerrar" layoutX="650.0" layoutY="395.0" 
                    mnemonicParsing="false" onAction="#cerrarVisor" 
                    prefHeight="35.0" prefWidth="160.0" 
                    styleClass="button" text="Cerrar">
               <effect>
                  <DropShadow color="#00000030" offsetX="0.0" offsetY="2.0" radius="4.0" />
               </effect>
            </Button>
            
         </children>
      </Pane>
   </children>
</Pane>