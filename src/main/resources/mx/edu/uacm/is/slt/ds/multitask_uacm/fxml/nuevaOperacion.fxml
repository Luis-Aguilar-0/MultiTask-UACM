<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<Pane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" 
      prefHeight="600.0" prefWidth="900.0" 
      style="-fx-background-color: #F2EDE6;" 
      stylesheets="@../css/estilos.css" 
      xmlns="http://javafx.com/javafx/21" 
      xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="mx.edu.uacm.is.slt.ds.multitask_uacm.controlador.NuevaOperacion">
      
   <children>
   
      <!-- HEADER -->
      <Pane prefHeight="90.0" prefWidth="900.0" 
            style="-fx-background-color: #D9CCC5; -fx-border-width: 0 0 2 0; -fx-border-color: #C3A495;">
         <children>
            <ImageView fx:id="logoImageView" fitHeight="70.0" fitWidth="150.0"
                       layoutX="20.0" layoutY="10.0"
                       pickOnBounds="true" preserveRatio="true" />
            
            <!-- Titulo sin CSS - estilo inline -->
            <Label layoutX="380.0" layoutY="28.0" text="Crear Operacion"
                   style="-fx-font-family: 'Arial Black'; -fx-font-size: 24px;" />
         </children>
         <effect>
            <DropShadow color="#2C1810" height="10.0" radius="4.5" width="10.0" />
         </effect>
      </Pane>

      <!-- CONTENEDOR PRINCIPAL -->
      <Pane layoutX="60.0" layoutY="120.0" prefHeight="440.0" prefWidth="780.0" 
            style="-fx-background-color: #FFFFFF; -fx-background-radius: 12; -fx-border-radius: 12; -fx-border-color: #D9CCC5; -fx-border-width: 2;">
         <effect>
            <DropShadow color="#00000015" offsetY="4.0" radius="10.0" />
         </effect>
         <children>
         
            <!-- Texto descriptivo con CSS normal -->
            <Label layoutX="40.0" layoutY="30.0" text="Define los detalles generales para inicializar un nuevo proceso en el gestor." 
                   styleClass="label-normal" />

            <!-- Campo Nombre -->
            <Label layoutX="40.0" layoutY="85.0" text="Nombre de la operacion:" styleClass="label-normal" />

            <TextField fx:id="txtField_nombreOp" 
                       layoutX="260.0" layoutY="80.0" 
                       prefHeight="40.0" prefWidth="480.0" 
                       promptText="Ej. Proceso de facturacion" 
                       style="-fx-font-size: 15px; -fx-background-radius: 8; -fx-border-radius: 8; -fx-padding: 8px;">

            </TextField>

            <!-- Campo Descripcion -->
            <Label layoutX="40.0" layoutY="150.0" text="Descripcion del flujo:" styleClass="label-normal" />

            <TextArea fx:id="txtArea_descripcion" 
                      layoutX="260.0" layoutY="150.0" 
                      prefHeight="170.0" prefWidth="480.0" 
                      promptText="Describe el proposito de esta operacion y su objetivo general..." 
                      style="-fx-font-size: 15px; -fx-background-radius: 8; -fx-border-radius: 8; -fx-padding: 8px;">

            </TextArea>

            <!-- Mensaje de Error -->
            <Label fx:id="lbl_msgError" 
                   alignment="CENTER" 
                   layoutX="260.0" layoutY="335.0" 
                   prefHeight="30.0" prefWidth="480.0" 
                   text="Error: Todos los campos son obligatorios" 
                   textFill="#d32f2f" 
                   visible="false">
               <font>
                  <Font name="Arial Black" size="14.0" />
               </font>
            </Label>

            <!-- BOTONES -->
            <Button fx:id="btn_guardarOp" 
                    layoutX="260.0" layoutY="375.0" 
                    mnemonicParsing="false" 
                    onAction="#ocClickNuevaOperacion" 
                    prefHeight="45.0" prefWidth="220.0" 
                    styleClass="button" 
                    text="Guardar Operacion" />
            
            <Button fx:id="btn_cancelar" 
                    layoutX="500.0" layoutY="375.0" 
                    mnemonicParsing="false" 
                    onAction="#onClosedVentana" 
                    prefHeight="45.0" prefWidth="220.0" 
                    styleClass="button" 
                    text="Cancelar" />
                    
         </children>
      </Pane>
   </children>
</Pane>