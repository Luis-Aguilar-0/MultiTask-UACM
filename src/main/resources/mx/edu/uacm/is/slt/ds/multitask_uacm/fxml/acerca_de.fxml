<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<Pane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" 
      prefHeight="600.0" prefWidth="900.0" 
      style="-fx-background-color: #F2EDE6;" 
      stylesheets="@../css/estilos.css"
      xmlns="http://javafx.com/javafx/21" 
      xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="mx.edu.uacm.is.slt.ds.multitask_uacm.controlador.AcercaDeController">
      
   <children>
   
      <!-- HEADER -->
      <Pane prefHeight="100.0" prefWidth="900.0" style="-fx-background-color: #D9CCC5; -fx-border-width: 0 0 2 0; -fx-border-color: #C3A495;">
         <effect>
            <DropShadow color="#0000001a" height="10.0" radius="4.5" width="10.0" />
         </effect>
         <children>
            <ImageView fx:id="logoImageView" fitHeight="75.0" fitWidth="160.0"
                       layoutX="25.0" layoutY="12.0"
                       pickOnBounds="true" preserveRatio="true" />
            
            <Label layoutX="360.0" layoutY="30.0" text="MultiTask - UACM" textFill="#2C1810">
               <font>
                  <Font name="Arial Black" size="32.0" />
               </font>
            </Label>
            
            <Label layoutX="390.0" layoutY="68.0" text="Sistema de Gestion de Tareas" textFill="#5C3D2E">
               <font>
                  <Font name="Arial" size="14.0" />
               </font>
            </Label>
         </children>
      </Pane>

      <!-- PANEL DE INFORMACION -->
      <Pane layoutX="30.0" layoutY="120.0" prefHeight="410.0" prefWidth="840.0" 
            style="-fx-background-color: #FFFFFF; -fx-background-radius: 15; -fx-border-radius: 15; -fx-border-color: #D9CCC5; -fx-border-width: 2;">
         <effect>
            <DropShadow color="#00000015" offsetX="2.0" offsetY="4.0" radius="12.0" />
         </effect>
         
         <children>
            <!-- TITULO DEL PANEL -->
            <Label layoutX="30.0" layoutY="20.0" text="Acerca del Sistema" textFill="#5C3D2E">
               <font>
                  <Font name="Arial Black" size="18.0" />
               </font>
            </Label>
            
            <Separator layoutX="30.0" layoutY="55.0" prefWidth="780.0" />

            <!-- SECCION IZQUIERDA -->
            <Label layoutX="50.0" layoutY="85.0" text="Version" styleClass="label-normal">
               <font>
                  <Font name="Arial Black" size="13.0" />
               </font>
            </Label>
            <TextField fx:id="lblVersion" layoutX="180.0" layoutY="80.0" prefHeight="32.0" prefWidth="200.0" 
                       editable="false" styleClass="text-field" />

            <Label layoutX="50.0" layoutY="135.0"
               text="Fecha de lanzamiento"
                  wrapText="true"
                  prefWidth="120"
                  styleClass="label-normal">
                     <font>
                      <Font name="Arial Black" size="13.0" />
                     </font>
            </Label>
            <TextField fx:id="lblFecha" layoutX="180.0" layoutY="130.0" prefHeight="32.0" prefWidth="200.0" 
                       editable="false" styleClass="text-field" />

            <!-- DIVISOR VERTICAL -->
            <Separator layoutX="420.0" layoutY="70.0" orientation="VERTICAL" prefHeight="300.0" prefWidth="5.0" 
                       style="-fx-background-color: #E8DFD9;" />

            <!-- SECCION DERECHA -->
            <Label layoutX="460.0" layoutY="85.0" text="Equipo de desarrollo" textFill="#5C3D2E">
               <font>
                  <Font name="Arial Black" size="14.0" />
               </font>
            </Label>
            <TextArea fx:id="txtEquipo" layoutX="460.0" layoutY="115.0" prefHeight="160.0" prefWidth="350.0" 
                      editable="false" styleClass="text-area" />

            <!-- CONTACTO -->
            <Label layoutX="50.0" layoutY="200.0" text="Contacto" textFill="#5C3D2E">
               <font>
                  <Font name="Arial Black" size="14.0" />
               </font>
            </Label>
            
            <Separator layoutX="50.0" layoutY="220.0" prefWidth="340.0" style="-fx-background-color: #E8DFD9;" />

            <Label layoutX="50.0" layoutY="245.0" text="Repositorio:" styleClass="label-normal">
               <font>
                  <Font name="Arial Black" size="12.0" />
               </font>
            </Label>
            <Hyperlink layoutX="180.0" layoutY="242.0" 
                       text="github.com/Luis-Aguilar-0/MultiTask-UACM" 
                       style="-fx-text-fill: #8B6914; -fx-underline: true;">
               <font>
                  <Font name="Arial" size="12.0" />
               </font>
            </Hyperlink>

            <Label layoutX="50.0" layoutY="280.0" text="Documentacion:" styleClass="label-normal">
               <font>
                  <Font name="Arial Black" size="12.0" />
               </font>
            </Label>
            <Hyperlink layoutX="180.0" layoutY="277.0" 
                       text="drive.google.com/multitask-uacm" 
                       style="-fx-text-fill: #8B6914; -fx-underline: true;">
               <font>
                  <Font name="Arial" size="12.0" />
               </font>
            </Hyperlink>

            <!-- LINEA INFERIOR -->
            <Separator layoutX="30.0" layoutY="360.0" prefWidth="780.0" style="-fx-background-color: #E8DFD9;" />
            
            <!-- CREDITOS -->
            <Label layoutX="50.0" layoutY="380.0" text="2026 MultiTask-UACM - Todos los derechos reservados" 
                   textFill="#999999" style="-fx-font-size: 11px;">
               <font>
                  <Font name="Arial" size="11.0" />
               </font>
            </Label>
            
         </children>
      </Pane>

      <!-- BOTON CERRAR -->
      <Button fx:id="btnCerrar" layoutX="760.0" layoutY="548.0" 
              mnemonicParsing="false" onAction="#cerrarVentana" 
              prefHeight="36.0" prefWidth="110.0" 
              styleClass="button" text="Cerrar">
         <effect>
            <DropShadow color="#00000030" offsetX="0.0" offsetY="2.0" radius="4.0" />
         </effect>
      </Button>
      
   </children>
</Pane>